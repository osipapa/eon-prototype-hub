# Copy to .env and fill from your Supabase project (Settings -> API).
# Only the PUBLIC anon key belongs in the client. NEVER put the service_role key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# GitHub Pages base path. Must be "/<your-repo-name>/" for a project site,
# or "/" for a user/org site (username.github.io).
VITE_BASE=/eon-prototype-hub/

# Mapbox PUBLIC (pk.) token that the setup prompt hands to map prototypes.
# Optional: without it, prompts leave maps out. Ask an admin for the value;
# GitHub push protection rejects it in source, so it lives only here and in
# the repo's Actions variables.
VITE_MAPBOX_TOKEN=
